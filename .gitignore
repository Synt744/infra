# =============================================================================
# Replit workspace — файлы окружения, не относящиеся к проекту
# =============================================================================

# Replit-специфичные конфиги
/.replit
/.replitignore
/.npmrc
/.cache/
/.local/

# Агентская память (внутренняя)
/.agents/

# pnpm-монорепо (Replit scaffolding, не часть IaC)
/package.json
/pnpm-lock.yaml
/pnpm-workspace.yaml
/tsconfig.base.json
/tsconfig.json
/node_modules/

# Replit артефакты (веб-приложения, не связанные с IaC)
/artifacts/

# Вспомогательные библиотеки Replit workspace
/lib/
/scripts/

# Прикреплённые файлы из чата
/attached_assets/

# =============================================================================
# Общее
# =============================================================================
*.tsbuildinfo
dist/
tmp/
out-tsc/
.DS_Store
Thumbs.db
.expo/
.expo-shared/

# =============================================================================
# Ansible (дублируется в infra/.gitignore, но на случай запуска из корня)
# =============================================================================
*.retry
infra/ansible/group_vars/all/vault.yml
infra/**/.env
