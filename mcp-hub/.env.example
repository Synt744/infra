# MetaMCP Hub — Environment Variables
# Скопируй в .env и заполни значения перед запуском

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=metamcp_user
# Сгенерируй: openssl rand -hex 16
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=metamcp_db

# ─── App ──────────────────────────────────────────────────────────────────────
# Реальный IP/hostname машины (не localhost!), с которого будут стучаться агенты.
# Пример: http://192.168.1.42:12008 или http://base128.local:12008
APP_URL=http://YOUR_HOST_IP:12008

# Сгенерируй: openssl rand -hex 32
BETTER_AUTH_SECRET=CHANGE_ME
